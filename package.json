{
  "name": "filtersun-agent-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "富滤盛（FILTERSUN）授权代理企业官网 —— 中英双语静态站点，面向腾讯云 EdgeOne 部署",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "crawl": "node scripts/crawl-catalog.mjs",
    "crawl:full": "node scripts/crawl-catalog.mjs --pages=200 --delay=70",
    "sync": "node scripts/sync-catalog.mjs",
    "sync:dry": "node scripts/sync-catalog.mjs --dry",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:media": "node scripts/fetch-assets.mjs --media",
    "assets:catalog": "node scripts/fetch-assets.mjs --catalog",
    "media": "node scripts/optimize-media.mjs",
    "brand": "node scripts/gen-brand-assets.mjs",
    "report": "node scripts/catalog-report.mjs",
    "shot": "node scripts/shot.mjs",
    "refresh": "pnpm crawl && pnpm assets && pnpm media && pnpm brand && pnpm report && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
