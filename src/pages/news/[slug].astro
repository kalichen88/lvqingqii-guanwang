---
/** 文章详情（中文） */
import BaseLayout from '../../layouts/BaseLayout.astro'
import NewsPostPage from '../../components/pages/NewsPostPage.astro'
import { news } from '../../data/content.mjs'
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo.mjs'

export function getStaticPaths() {
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props
const lang = 'zh' as const

const jsonLd = [
  articleJsonLd(lang, post),
  breadcrumbJsonLd(lang, [
    { label: '首页', href: '/' },
    { label: '新闻资讯', href: '/news/' },
    { label: post.title.zh, href: `/news/${post.slug}/` },
  ]),
]
---

<BaseLayout
  {lang}
  title={post.title.zh}
  description={post.summary.zh}
  pathname={`/news/${post.slug}/`}
  image={post.cover}
  jsonLd={jsonLd}
>
  <NewsPostPage {lang} {post} />
</BaseLayout>
