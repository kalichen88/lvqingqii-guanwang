---
/** 404（中文） */
import BaseLayout from '../layouts/BaseLayout.astro'
import NotFoundPage from '../components/pages/NotFoundPage.astro'

const lang = 'zh' as const
---

<BaseLayout
  {lang}
  title="页面不存在"
  description="你访问的页面不存在或已失效。可以返回首页、使用件号查询，或直接联系我们。"
  pathname="/404"
  noindex={true}
>
  <NotFoundPage {lang} />
</BaseLayout>
