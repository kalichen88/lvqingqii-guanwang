---
/** 产品大类详情（中文） */
import BaseLayout from '../../layouts/BaseLayout.astro'
import GroupPage from '../../components/pages/GroupPage.astro'
import { groups, groupStats } from '../../data/products.mjs'
import { collectionJsonLd, breadcrumbJsonLd } from '../../lib/seo.mjs'

export function getStaticPaths() {
  return groups.map((group) => ({ params: { group: group.slug }, props: { group } }))
}

const { group } = Astro.props
const lang = 'zh' as const
const stat = groupStats[group.slug]

const jsonLd = [
  collectionJsonLd(lang, {
    name: group.nameZh,
    description: group.descZh,
    url: `/products/${group.slug}/`,
  }),
  breadcrumbJsonLd(lang, [
    { label: '首页', href: '/' },
    { label: '产品中心', href: '/products/' },
    { label: group.nameZh, href: `/products/${group.slug}/` },
  ]),
]
---

<BaseLayout
  {lang}
  title={`${group.nameZh}_${stat?.count ?? 0}个件号_规格查询与现货报价`}
  description={`${group.descZh.slice(0, 70)}…共 ${stat?.count ?? 0} 个件号、${stat?.typeCount ?? 0} 个细分品类，附规格尺寸与实物图。`}
  pathname={`/products/${group.slug}/`}
  jsonLd={jsonLd}
>
  <GroupPage {lang} {group} />
</BaseLayout>
