---
/** 品牌与品质（非默认语言） */
import BaseLayout from '../../layouts/BaseLayout.astro'
import QualityPage from '../../components/pages/QualityPage.astro'
import siteConfig from '../../../site.config.mjs'
import { PREFIXED_LANGS } from '../../i18n/index.mjs'
import { pageTitle, pageDesc } from '../../i18n/meta.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as string

const pr = siteConfig.principal
const ctx = {
  principalZh: pr.nameZh,
  principalEn: pr.nameEn,
  patents: pr.facts.patents,
  plantArea: pr.facts.plantAreaSqm,
  countries: pr.facts.exportCountries,
}
---

<BaseLayout
  {lang}
  title={pageTitle(lang, 'quality', ctx)}
  description={pageDesc(lang, 'quality', ctx)}
  pathname="/quality/"
>
  <QualityPage {lang} />
</BaseLayout>
