---
/** 常见问题（非默认语言） */
import BaseLayout from '../../layouts/BaseLayout.astro'
import FaqPage from '../../components/pages/FaqPage.astro'
import { faqJsonLd } from '../../lib/seo.mjs'
import { faqs } from '../../data/content.mjs'
import { PREFIXED_LANGS, pick } from '../../i18n/index.mjs'
import { pageTitle, pageDesc } from '../../i18n/meta.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as string

const jsonLd = [faqJsonLd(faqs.map((f) => ({ q: pick(lang, f.q), a: pick(lang, f.a) })))]
---

<BaseLayout
  {lang}
  title={pageTitle(lang, 'faq')}
  description={pageDesc(lang, 'faq')}
  pathname="/faq/"
  jsonLd={jsonLd}
>
  <FaqPage {lang} />
</BaseLayout>
