---
/** 应用领域（非默认语言） */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ApplicationsIndexPage from '../../../components/pages/ApplicationsIndexPage.astro'
import { collectionJsonLd } from '../../../lib/seo.mjs'
import { applications } from '../../../data/applications.mjs'
import { PREFIXED_LANGS, bi, t } from '../../../i18n/index.mjs'
import { pageTitle, pageDesc } from '../../../i18n/meta.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as string

const jsonLd = [
  collectionJsonLd(lang, {
    name: t(lang, 'homeAppsTitle'),
    description: t(lang, 'homeAppsDesc'),
    url: '/applications/',
    items: applications.map((a) => ({ name: bi(lang, a, 'name'), href: `/applications/${a.slug}/` })),
  }),
]
---

<BaseLayout
  {lang}
  title={pageTitle(lang, 'applications')}
  description={pageDesc(lang, 'applications')}
  pathname="/applications/"
  jsonLd={jsonLd}
>
  <ApplicationsIndexPage {lang} />
</BaseLayout>
