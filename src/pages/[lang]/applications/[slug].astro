---
/** 应用领域详情（非默认语言） */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ApplicationPage from '../../../components/pages/ApplicationPage.astro'
import { applications } from '../../../data/applications.mjs'
import { collectionJsonLd, breadcrumbJsonLd } from '../../../lib/seo.mjs'
import { PREFIXED_LANGS, bi, t } from '../../../i18n/index.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.flatMap((lang) =>
    applications.map((application) => ({
      params: { lang, slug: application.slug },
      props: { application },
    })),
  )
}

const lang = Astro.params.lang as string
const { application } = Astro.props
const aName = bi(lang, application, 'name')
const aDesc = bi(lang, application, 'desc')

const jsonLd = [
  collectionJsonLd(lang, {
    name: aName,
    description: aDesc,
    url: `/applications/${application.slug}/`,
  }),
  breadcrumbJsonLd(lang, [
    { label: t(lang, 'home'), href: '/' },
    { label: t(lang, 'navSolutions'), href: '/applications/' },
    { label: aName, href: `/applications/${application.slug}/` },
  ]),
]
---

<BaseLayout
  {lang}
  title={`${aName} — ${t(lang, 'navSolutions')}`}
  description={`${aDesc.slice(0, 118)}…`}
  pathname={`/applications/${application.slug}/`}
  image={application.image}
  jsonLd={jsonLd}
>
  <ApplicationPage {lang} {application} />
</BaseLayout>
