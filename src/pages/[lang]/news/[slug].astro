---
/** 文章详情（非默认语言） */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import NewsPostPage from '../../../components/pages/NewsPostPage.astro'
import { news } from '../../../data/content.mjs'
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/seo.mjs'
import { PREFIXED_LANGS, pick, t } from '../../../i18n/index.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.flatMap((lang) =>
    news.map((post) => ({ params: { lang, slug: post.slug }, props: { post } })),
  )
}

const lang = Astro.params.lang as string
const { post } = Astro.props

const jsonLd = [
  articleJsonLd(lang, post),
  breadcrumbJsonLd(lang, [
    { label: t(lang, 'home'), href: '/' },
    { label: t(lang, 'navNews'), href: '/news/' },
    { label: pick(lang, post.title), href: `/news/${post.slug}/` },
  ]),
]
---

<BaseLayout
  {lang}
  title={pick(lang, post.title)}
  description={pick(lang, post.summary)}
  pathname={`/news/${post.slug}/`}
  image={post.cover}
  jsonLd={jsonLd}
>
  <NewsPostPage {lang} {post} />
</BaseLayout>
