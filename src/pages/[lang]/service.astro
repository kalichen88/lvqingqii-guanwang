---
/** 服务与支持（非默认语言） */
import BaseLayout from '../../layouts/BaseLayout.astro'
import ServicePage from '../../components/pages/ServicePage.astro'
import { PREFIXED_LANGS } from '../../i18n/index.mjs'
import { pageTitle, pageDesc } from '../../i18n/meta.mjs'

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as string
---

<BaseLayout
  {lang}
  title={pageTitle(lang, 'service')}
  description={pageDesc(lang, 'service')}
  pathname="/service/"
>
  <ServicePage {lang} />
</BaseLayout>
