---
/** 关于我们（中文） */
import BaseLayout from '../layouts/BaseLayout.astro'
import AboutPage from '../components/pages/AboutPage.astro'
import siteConfig from '../../site.config.mjs'

const lang = 'zh' as const
---

<BaseLayout
  {lang}
  title="关于我们_滤清器供应与选型支持"
  description={`专注${siteConfig.principal.nameZh}滤清器的供应与选型支持，覆盖工程机械、商用车、空压机与工业过滤，规格尺寸与实物图齐全，可提供批次与出入库记录用于溯源。`}
  pathname="/about/"
>
  <AboutPage {lang} />
</BaseLayout>
