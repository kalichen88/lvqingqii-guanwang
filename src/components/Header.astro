---
/**
 * Header.astro — 全站页头
 * ---------------------------------------------------------------------------
 * 结构：顶部信息条 + 主导航（含产品/应用两个大菜单）+ 移动端抽屉。
 *
 * 配色策略：所有前景色来自 global.css 里以 [data-header] 为作用域的 CSS 变量，
 * 因此「透明浮在深色首屏」与「滚动后变白色实底」可以纯 CSS 切换，
 * 不会出现深色文字配深色背景这类低对比问题。JS 只负责切换 data-scrolled。
 */
import siteConfig from '../../site.config.mjs'
import { t, localizePath, altLangPath, buildNav } from '../i18n/index.mjs'
import { groups } from '../data/groups.mjs'
import { applications } from '../data/applications.mjs'
import { groupStats } from '../data/products.mjs'
import Logo from './Logo.astro'
import Icon from './Icon.astro'

interface Props {
  lang: 'zh' | 'en'
  pathname: string
  darkHeader?: boolean
  transparentHeader?: boolean
}

const { lang, pathname, darkHeader = false, transparentHeader = false } = Astro.props
const isEn = lang === 'en'
const nav = buildNav(lang)
const other = isEn ? 'zh' : 'en'
const switchHref = altLangPath(pathname, other)

const c = siteConfig.contact
const phone = c.salesPhone
const telHref = `tel:${phone.replace(/[^\d+]/g, '')}`

const homeHref = localizePath('/', lang)
const isActive = (href: string) => href !== homeHref && pathname.startsWith(href)

const productHref = localizePath('/products/', lang)
const appsHref = localizePath('/applications/', lang)
const finderHref = localizePath('/search/', lang)
const quoteHref = localizePath('/contact/#quote', lang)
---

<!-- ======================= 顶部信息条 ======================= -->
<div class="hidden border-b border-ink-100 bg-ink-50 lg:block">
  <div class="shell flex h-10 items-center justify-between text-[12.5px]">
    <span class="inline-flex items-center gap-2 text-ink-500">
      <span class="relative flex size-1.5">
        <span class="absolute inline-flex size-full animate-pulse-ring rounded-full bg-brand-500"></span>
        <span class="relative inline-flex size-1.5 rounded-full bg-brand-500"></span>
      </span>
      {t(lang, 'headerTopbar')}
    </span>

    <div class="flex items-center gap-5">
      <a href={telHref} class="inline-flex items-center gap-2 font-medium text-ink-700 transition hover:text-brand-600">
        <Icon name="phone" class="size-3.5 text-brand-500" />
        <span class="tnum">{phone}</span>
      </a>
      {
        c.landline && (
          <>
            <span class="h-3 w-px bg-ink-200" />
            <a href={`tel:${c.landline.replace(/[^\d+]/g, '')}`} class="tnum text-ink-500 transition hover:text-brand-600">
              {c.landline}
            </a>
          </>
        )
      }
      <span class="h-3 w-px bg-ink-200"></span>
      <a href={`mailto:${c.email}`} class="inline-flex items-center gap-2 text-ink-500 transition hover:text-brand-600">
        <Icon name="mail" class="size-3.5" />
        {c.email}
      </a>
      <span class="h-3 w-px bg-ink-200"></span>
      <a href={switchHref} hreflang={other} class="inline-flex items-center gap-1.5 text-ink-500 transition hover:text-brand-600">
        <Icon name="globe" class="size-3.5" />
        {t(lang, 'langSwitch')}
      </a>
    </div>
  </div>
</div>

<!-- ======================= 主导航 ======================= -->
<header
  id="site-header"
  data-header
  data-transparent={transparentHeader ? 'true' : 'false'}
  data-dark={darkHeader ? 'true' : 'false'}
  data-scrolled="false"
  class:list={[
    'sticky top-0 z-50 w-full transition-[background-color,box-shadow] duration-300',
    !transparentHeader && (darkHeader ? 'bg-ink-950/85 backdrop-blur-xl' : 'bg-white/90 backdrop-blur-xl'),
  ]}
>
  <div class="shell">
    <div class="flex h-[68px] items-center justify-between gap-4 lg:h-[var(--header-h)]">
      <Logo variant="inherit" showTagline={true} href={homeHref} {lang} class="shrink-0" />

      <!-- 桌面导航 -->
      <nav class="hidden items-center gap-0.5 lg:flex" aria-label={isEn ? 'Main' : '主导航'}>
        <!-- 产品中心 -->
        <div class="group/nav relative">
          <a href={productHref} class="nav-link inline-flex h-10 items-center gap-1.5 rounded-lg px-3 text-[14.5px] font-medium" data-active={isActive(productHref)} aria-haspopup="true">
            {t(lang, 'navProducts')}
            <Icon name="chevron-down" class="size-3.5 transition-transform duration-300 group-hover/nav:rotate-180" />
          </a>

          <div class="invisible absolute left-1/2 top-full z-50 w-[min(92vw,940px)] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-300 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
            <div class="overflow-hidden rounded-2xl bg-white shadow-deep ring-1 ring-ink-100">
              <div class="grid grid-cols-2 gap-x-2 gap-y-0.5 p-3 xl:grid-cols-4">
                {
                  groups.map((g) => {
                    const stat = groupStats[g.slug]
                    return (
                      <a href={localizePath(`/products/${g.slug}/`, lang)} class="group/item flex items-start gap-3 rounded-xl p-3 transition hover:bg-brand-50">
                        <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-ink-50 text-ink-500 transition group-hover/item:bg-brand-500 group-hover/item:text-white">
                          <Icon name={g.icon} class="size-[18px]" />
                        </span>
                        <span class="min-w-0">
                          <span class="block truncate text-[13.5px] font-semibold text-ink-800 group-hover/item:text-brand-700">
                            {isEn ? g.nameEn : g.nameZh}
                          </span>
                          <span class="mt-0.5 block truncate text-[11.5px] text-ink-400">
                            {stat?.count ?? 0} {t(lang, 'productsCount')} · {stat?.typeCount ?? 0}{' '}
                            {isEn ? 'types' : '品类'}
                          </span>
                        </span>
                      </a>
                    )
                  })
                }
              </div>

              <div class="flex items-center justify-between gap-4 border-t border-ink-100 bg-ink-50/70 px-5 py-3.5">
                <span class="text-[12.5px] text-ink-500">
                  {isEn ? 'Not sure which part? Use the part finder.' : '不确定件号？用查询工具，或把旧滤芯照片发给我们。'}
                </span>
                <a href={finderHref} class="btn btn-primary btn-sm">
                  <Icon name="search" class="size-4" />
                  {t(lang, 'navSearch')}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 应用领域 -->
        <div class="group/nav relative">
          <a href={appsHref} class="nav-link inline-flex h-10 items-center gap-1.5 rounded-lg px-3 text-[14.5px] font-medium" data-active={isActive(appsHref)} aria-haspopup="true">
            {t(lang, 'navSolutions')}
            <Icon name="chevron-down" class="size-3.5 transition-transform duration-300 group-hover/nav:rotate-180" />
          </a>

          <div class="invisible absolute left-1/2 top-full z-50 w-[min(92vw,860px)] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-300 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
            <div class="overflow-hidden rounded-2xl bg-white shadow-deep ring-1 ring-ink-100">
              <div class="grid grid-cols-2 gap-1 p-3 xl:grid-cols-3">
                {
                  applications.slice(0, 18).map((a) => (
                    <a href={localizePath(`/applications/${a.slug}/`, lang)} class="group/item flex items-center gap-3 rounded-xl px-3 py-2.5 transition hover:bg-brand-50">
                      <Icon name={a.icon} class="size-4 shrink-0 text-ink-400 transition group-hover/item:text-brand-500" />
                      <span class="truncate text-[13.5px] font-medium text-ink-700 group-hover/item:text-brand-700">
                        {isEn ? a.nameEn : a.nameZh}
                      </span>
                    </a>
                  ))
                }
              </div>
              <div class="border-t border-ink-100 bg-ink-50/70 px-5 py-3.5">
                <a href={appsHref} class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-brand-600 hover:text-brand-700">
                  {isEn ? 'All industries' : '查看全部应用领域'}
                  <Icon name="arrow-right" class="size-4" />
                </a>
              </div>
            </div>
          </div>
        </div>

        {
          nav
            .filter((n) => !['products', 'solutions'].includes(n.key))
            .map((n) => (
              <a href={n.href} class="nav-link inline-flex h-10 items-center rounded-lg px-3 text-[14.5px] font-medium" data-active={isActive(n.href)}>
                {n.label}
              </a>
            ))
        }
      </nav>

      <!-- 右侧操作区 -->
      <div class="flex items-center gap-2">
        <a href={finderHref} class="nav-chip hidden h-10 items-center gap-2 whitespace-nowrap rounded-lg px-3 text-[13.5px] font-medium 2xl:inline-flex">
          <Icon name="search" class="size-4" />
          {isEn ? 'Part finder' : '件号查询'}
        </a>

        <a href={quoteHref} class="btn btn-primary hidden whitespace-nowrap md:inline-flex">
          <Icon name="mail" class="size-4" />
          {t(lang, 'getQuote')}
        </a>

        <button
          type="button"
          class="nav-icon-btn inline-flex size-10 items-center justify-center rounded-lg lg:hidden"
          data-menu-open
          aria-label={t(lang, 'menu')}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
  </div>

  <!-- 滚动后的细分隔线 -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-ink-100 opacity-0 transition-opacity duration-300" data-header-line>
  </div>
</header>

<!-- ======================= 移动端抽屉 ======================= -->
<div id="mobile-menu" class="fixed inset-0 z-[60] hidden lg:hidden" data-menu-panel aria-hidden="true">
  <div class="absolute inset-0 bg-ink-950/60 backdrop-blur-sm" data-menu-backdrop></div>

  <div
    class="absolute inset-y-0 right-0 flex w-[min(88vw,400px)] translate-x-full flex-col bg-white shadow-deep transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    data-menu-drawer
  >
    <div class="flex h-16 items-center justify-between border-b border-ink-100 px-5">
      <Logo href={homeHref} {lang} compact />
      <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg text-ink-600 ring-1 ring-ink-200" data-menu-close aria-label={t(lang, 'close')}>
        <Icon name="close" class="size-5" />
      </button>
    </div>

    <div class="flex-1 overflow-y-auto overscroll-contain px-5 py-5">
      <form action={finderHref} method="get" class="relative mb-5">
        <Icon name="search" class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-ink-400" />
        <input
          type="search"
          name="q"
          placeholder={isEn ? 'Part number or keyword' : '输入件号或关键词'}
          class="h-11 w-full rounded-xl border-0 bg-ink-50 pl-10 pr-3 text-[14px] text-ink-800 ring-1 ring-ink-100 placeholder:text-ink-400 focus:bg-white focus:ring-2 focus:ring-brand-500"
        />
      </form>

      <nav class="space-y-1">
        {
          nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'flex items-center justify-between rounded-xl px-4 py-3 text-[15px] font-medium transition',
                isActive(n.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-700 hover:bg-ink-50',
              ]}
            >
              {n.label}
              <Icon name="chevron-right" class="size-4 text-ink-300" />
            </a>
          ))
        }
      </nav>

      <div class="mt-6">
        <p class="px-4 pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-ink-400">
          {t(lang, 'navProducts')}
        </p>
        <div class="space-y-0.5">
          {
            groups.map((g) => (
              <a href={localizePath(`/products/${g.slug}/`, lang)} class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-[14px] text-ink-600 transition hover:bg-ink-50">
                <Icon name={g.icon} class="size-4 text-ink-400" />
                {isEn ? g.nameEn : g.nameZh}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="space-y-3 border-t border-ink-100 bg-ink-50/60 px-5 py-5">
      <a href={telHref} class="btn btn-dark w-full">
        <Icon name="phone" class="size-4" />
        <span class="tnum">{phone}</span>
      </a>
      <a href={quoteHref} class="btn btn-primary w-full">{t(lang, 'getQuote')}</a>
      <a href={switchHref} class="flex items-center justify-center gap-2 py-1 text-[13.5px] font-medium text-ink-500">
        <Icon name="globe" class="size-4" />
        {t(lang, 'langSwitch')}
      </a>
    </div>
  </div>
</div>

<script>
  /* 只负责切换 data-scrolled，配色交给 CSS 变量 */
  const header = document.querySelector<HTMLElement>('[data-header]')
  const line = document.querySelector<HTMLElement>('[data-header-line]')

  if (header) {
    let ticking = false
    const apply = () => {
      ticking = false
      const scrolled = window.scrollY > 12
      header.dataset.scrolled = scrolled ? 'true' : 'false'
      if (line) line.style.opacity = scrolled ? '1' : '0'
    }
    apply()
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(apply)
        }
      },
      { passive: true },
    )
  }

  /* 移动端抽屉 */
  const panel = document.getElementById('mobile-menu')
  const drawer = panel?.querySelector<HTMLElement>('[data-menu-drawer]')
  const openBtn = document.querySelector<HTMLElement>('[data-menu-open]')
  const closeBtn = panel?.querySelector<HTMLElement>('[data-menu-close]')
  const backdrop = panel?.querySelector<HTMLElement>('[data-menu-backdrop]')

  const openMenu = () => {
    if (!panel || !drawer) return
    panel.classList.remove('hidden')
    panel.setAttribute('aria-hidden', 'false')
    openBtn?.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    requestAnimationFrame(() => drawer.classList.remove('translate-x-full'))
  }

  const closeMenu = () => {
    if (!panel || !drawer) return
    drawer.classList.add('translate-x-full')
    panel.setAttribute('aria-hidden', 'true')
    openBtn?.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    window.setTimeout(() => panel.classList.add('hidden'), 320)
  }

  openBtn?.addEventListener('click', openMenu)
  closeBtn?.addEventListener('click', closeMenu)
  backdrop?.addEventListener('click', closeMenu)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.classList.contains('hidden')) closeMenu()
  })
</script>
