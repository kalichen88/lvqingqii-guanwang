const dimension = size ?? undefined
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  width={dimension}
  height={dimension}
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
