/**
 * Icon.astro — 统一图标组件
 * ---------------------------------------------------------------------------
 * 全部为自绘 24×24 线性图标（stroke 风格，1.6 描边），保证视觉一致。
 * 用法：<Icon name="truck" class="size-6" />
 * 新增图标只需在下方 ICONS 里加一条。
 */

interface Props {
  name: string
  class?: string
  size?: number | string
  strokeWidth?: number
  filled?: boolean
}

