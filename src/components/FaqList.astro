---
/**
 * FaqList.astro — 常见问题手风琴
 * ---------------------------------------------------------------------------
 * 使用原生 <details>/<summary>，无 JS 也能展开，兼顾无障碍与 SEO。
 */
import Icon from './Icon.astro'

interface Item {
  q: string
  a: string
}

interface Props {
  items: Item[]
  lang: 'zh' | 'en'
  class?: string
}

const { items, lang, class: className = '' } = Astro.props
---

<div class:list={['divide-y divide-ink-100 overflow-hidden rounded-2xl bg-white ring-1 ring-ink-100', className]}>
  {
    items.map((item, i) => (
      <details class="group" data-faq-item open={i === 0}>
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 transition hover:bg-ink-50/70 md:px-6"
        >
          <span class="flex items-start gap-3.5">
            <span class="mt-0.5 font-mono text-[12px] font-medium tabular-nums text-brand-500">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-[15px] font-semibold leading-relaxed text-ink-900 md:text-[16px]">
              {item.q}
            </span>
          </span>
          <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-500 transition-all duration-300 group-open:rotate-45 group-open:bg-brand-500 group-open:text-white">
            <Icon name="plus" class="size-3.5" strokeWidth={2} />
          </span>
        </summary>
        <div class="px-5 pb-5 md:px-6 md:pb-6">
          <p class="prose-cn !text-[14.5px] !leading-[1.85] pl-[34px]">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
