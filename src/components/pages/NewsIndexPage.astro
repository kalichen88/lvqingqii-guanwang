---
/**
 * NewsIndexPage.astro — 新闻与文章列表
 */
import { t, localizePath } from '../../i18n/index.mjs'
import { news } from '../../data/content.mjs'
import Icon from '../Icon.astro'
import PageHero from '../PageHero.astro'
import InquiryForm from '../InquiryForm.astro'

interface Props {
  lang: 'zh' | 'en'
}
const { lang } = Astro.props
const isEn = lang === 'en'
const p = (path: string) => localizePath(path, lang)

const crumbs = [
  { label: t(lang, 'home'), href: '/' },
  { label: t(lang, 'navNews') },
]

const [lead, ...rest] = news
---

<PageHero
  {lang}
  eyebrow={isEn ? 'News & guides' : '新闻资讯'}
  title={isEn ? 'Selection guides and maintenance notes' : '选型指南与运维笔记'}
  desc={isEn
    ? 'Written by people who handle filter failures every week. No press-release reposts.'
    : '由每周都在处理滤芯故障的人写的。不是转载的通稿。'}
  crumbs={crumbs}
/>

<section class="section-tight bg-white">
  <div class="shell">
    <!-- 头条 -->
    <a
      href={p(`/news/${lead.slug}/`)}
      class="card card-hover group grid gap-0 overflow-hidden md:grid-cols-2"
      data-reveal
    >
      <div class="aspect-[16/10] overflow-hidden bg-ink-100 md:aspect-auto md:h-full md:min-h-[320px]">
        <img
          src={lead.cover}
          alt={lead.title[lang]}
          width="900"
          height="560"
          loading="lazy"
          class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
        />
      </div>
      <div class="flex flex-col justify-center p-7 md:p-9">
        <div class="flex items-center gap-3 text-[11.5px] text-ink-400">
          <span class="chip chip-brand">{lead.category[lang]}</span>
          <time datetime={lead.date} class="tnum">{lead.date}</time>
        </div>
        <h2 class="mt-5 text-[22px] font-semibold leading-snug text-ink-900 transition group-hover:text-brand-600 md:text-[26px]">
          {lead.title[lang]}
        </h2>
        <p class="mt-4 text-[14px] leading-relaxed text-ink-500">{lead.summary[lang]}</p>
        <span class="mt-6 inline-flex items-center gap-2 text-[13.5px] font-semibold text-brand-600">
          {t(lang, 'readMore')}
          <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
        </span>
      </div>
    </a>

    <!-- 其余 -->
    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((post, i) => (
          <a
            href={p(`/news/${post.slug}/`)}
            class="card card-hover group flex flex-col overflow-hidden"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 60}ms`}
          >
            <div class="aspect-[16/10] overflow-hidden bg-ink-100">
              <img
                src={post.cover}
                alt={post.title[lang]}
                width="800"
                height="500"
                loading="lazy"
                class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-3 text-[11.5px] text-ink-400">
                <span class="chip chip-brand">{post.category[lang]}</span>
                <time datetime={post.date} class="tnum">{post.date}</time>
              </div>
              <h2 class="mt-4 line-clamp-2 text-[16px] font-semibold leading-snug text-ink-900 transition group-hover:text-brand-600">
                {post.title[lang]}
              </h2>
              <p class="mt-2.5 line-clamp-3 text-[13px] leading-relaxed text-ink-500">
                {post.summary[lang]}
              </p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[12.5px] font-semibold text-brand-600">
                {t(lang, 'readMore')}
                <Icon name="arrow-right" class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section bg-ink-50">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <span class="eyebrow">{isEn ? 'Have a question?' : '有具体问题？'}</span>
      <h2 class="mt-3 text-[24px] font-semibold leading-tight text-ink-900 md:text-[30px]">
        {isEn ? 'Ask it directly' : '直接问我们'}
      </h2>
      <p class="mt-4 text-[14px] leading-relaxed text-ink-500">
        {isEn
          ? 'If an article raised a question about your own machine, send us the details — that is usually faster than reading more.'
          : '如果某篇文章让你想到自己设备上的具体问题，把信息发给我们——通常比继续看文章更快。'}
      </p>
    </div>
    <div class="lg:col-span-7">
      <InquiryForm {lang} />
    </div>
  </div>
</section>
