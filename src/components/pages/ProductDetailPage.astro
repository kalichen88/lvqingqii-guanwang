---
/**
 * ProductDetailPage.astro — 件号详情页（/p/<件号>/）
 * ---------------------------------------------------------------------------
 * 这是承接长尾搜索的核心页面：真实件号 + 真实规格 + 品类上下文 +
 * 相关件号 + 结构化数据，避免成为「薄内容」页。
 */
import siteConfig from '../../../site.config.mjs'
import { t, localizePath } from '../../i18n/index.mjs'
import { getRelated, groupBySlug } from '../../data/products.mjs'
import { applicationBySlug } from '../../data/applications.mjs'
import { productFeatures, faqs } from '../../data/content.mjs'
import Icon from '../Icon.astro'
import ProductCard from '../ProductCard.astro'
import Breadcrumbs from '../Breadcrumbs.astro'
import InquiryForm from '../InquiryForm.astro'
import FaqList from '../FaqList.astro'

interface Props {
  lang: 'zh' | 'en'
  product: {
    partNo: string
    spec: string
    type: string
    typeEn: string
    group: string
    categoryName: string
    parentName?: string
    image: string | null
    categoryId: number
  }
}

const { lang, product } = Astro.props
const isEn = lang === 'en'
const p = (path: string) => localizePath(path, lang)
const c = siteConfig.contact
const pr = siteConfig.principal

const group = groupBySlug[product.group]
const related = getRelated(product, 8)
const typeLabel = isEn ? product.typeEn || product.type : product.type
const tel = `tel:${c.salesPhone.replace(/[^\d+]/g, '')}`
const wa = `https://wa.me/${c.whatsapp}?text=${encodeURIComponent(
  isEn ? `Hello, I would like to enquire about ${product.partNo}.` : `你好，我想咨询 ${product.partNo} 这个件号。`,
)}`

const relatedApps = (group?.applications ?? []).map((s) => applicationBySlug[s]).filter(Boolean).slice(0, 6)

const crumbs = [
  { label: t(lang, 'home'), href: '/' },
  { label: t(lang, 'productsTitle'), href: '/products/' },
  ...(group ? [{ label: isEn ? group.nameEn : group.nameZh, href: `/products/${group.slug}/` }] : []),
  { label: product.partNo },
]

/** 规格尺寸拆分展示：形如 406*Ø265*Ø153/Ø17 */
const specParts = product.spec
  ? product.spec
      .split('*')
      .map((s) => s.trim())
      .filter(Boolean)
  : []

const quickFaqs = faqs.slice(0, 4).map((f) => ({ q: f.q[lang], a: f.a[lang] }))
---

<!-- ================= Hero / 主信息 ================= -->
<section class="page-hero pb-14 pt-10 md:pb-16 md:pt-12">
  <div class="shell relative">
    <Breadcrumbs {lang} items={crumbs} />

    <div class="mt-7 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- 图片 -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-3xl bg-white shadow-lift ring-1 ring-ink-100">
          {
            product.image ? (
              <img
                src={product.image}
                alt={`${product.partNo} ${typeLabel}`}
                width="700"
                height="560"
                fetchpriority="high"
                decoding="async"
                class="relative aspect-[5/4] w-full bg-white object-contain p-8"
              />
            ) : (
              <div class="relative flex aspect-[5/4] flex-col items-center justify-center gap-4 bg-ink-50 text-ink-300">
                <Icon name={group?.icon ?? 'layers'} class="size-20 opacity-40" strokeWidth={1.1} />
                <p class="text-[12.5px] text-ink-400">
                  {isEn ? 'Photo available on request' : '实物图请联系客服索取'}
                </p>
              </div>
            )
          }
        </div>

        <div class="mt-4 grid grid-cols-3 gap-3">
          {
            [
              { icon: 'shield', l: { zh: '原厂正品', en: 'Genuine' } },
              { icon: 'box', l: { zh: '可现货', en: 'In stock' } },
              { icon: 'certificate', l: { zh: '三包质保', en: 'Warranty' } },
            ].map((b) => (
              <div class="flex flex-col items-center gap-2 rounded-xl bg-white py-3.5 shadow-soft ring-1 ring-ink-100">
                <Icon name={b.icon} class="size-4 text-brand-500" />
                <span class="text-[11.5px] text-ink-600">{b.l[lang]}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 信息 -->
      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-center gap-2.5">
          {group && <span class="chip chip-brand">{isEn ? group.nameEn : group.nameZh}</span>}
          {typeLabel && <span class="chip">{typeLabel}</span>}
        </div>

        <h1 class="mt-5 flex flex-wrap items-baseline gap-4" data-reveal>
          <span class="partno text-[34px] font-semibold leading-none text-ink-900 md:text-[46px]">
            {product.partNo}
          </span>
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 text-[12px] text-ink-500 shadow-soft ring-1 ring-ink-200 transition hover:text-brand-600 hover:ring-brand-300"
            data-copy={product.partNo}
            aria-label={t(lang, 'copy')}
          >
            <Icon name="copy" class="size-3.5" />
            <span data-copy-label>{t(lang, 'copy')}</span>
          </button>
        </h1>

        <p class="mt-4 max-w-2xl text-[15px] leading-[1.85] text-ink-500" data-reveal>
          {
            isEn
              ? `${product.partNo} is a genuine FILTERSUN ${typeLabel}${product.spec ? ` measuring ${product.spec}` : ''}, supplied through the manufacturer's official channel by an authorized distributor.`
              : `${product.partNo} 是富滤盛（FILTERSUN）${typeLabel}${product.spec ? `，规格 ${product.spec}` : ''}，由授权代理通过厂家正规渠道供货，正品保障、可溯源。`
          }
        </p>

        <!-- 参数表 -->
        <dl class="mt-8 grid gap-px overflow-hidden rounded-2xl bg-ink-100 shadow-soft ring-1 ring-ink-100 sm:grid-cols-2">
          {
            [
              { k: t(lang, 'partNo'), v: product.partNo, mono: true },
              { k: t(lang, 'type'), v: typeLabel },
              { k: t(lang, 'spec'), v: product.spec || (isEn ? 'Ask us' : '请联系客服'), mono: true },
              { k: isEn ? 'Category' : '所属品类', v: product.categoryName },
              {
                k: t(lang, 'oemRef'),
                v: t(lang, 'oemRefValue'),
              },
              { k: isEn ? 'Brand' : '品牌', v: 'FILTERSUN' },
            ].map((row) => (
              <div class="bg-white px-5 py-4">
                <dt class="text-[11.5px] text-ink-400">{row.k}</dt>
                <dd class:list={['mt-1.5 text-[14px] text-ink-900', row.mono && 'tnum font-mono text-[13.5px]']}>
                  {row.v}
                </dd>
              </div>
            ))
          }
        </dl>

        <!-- 规格拆解 -->
        {
          specParts.length > 1 && (
            <div class="mt-6">
              <p class="text-[11.5px] uppercase tracking-[0.14em] text-ink-400">
                {isEn ? 'Dimensions breakdown' : '尺寸拆解'}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {specParts.map((s, i) => (
                  <span class="rounded-lg bg-white px-3 py-2 font-mono text-[12.5px] text-ink-700 shadow-soft ring-1 ring-ink-200">
                    {['A', 'B', 'C', 'D', 'E'][i] ?? i + 1} · {s}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <!-- 行动按钮 -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#quote" class="btn btn-primary btn-lg">
            <Icon name="mail" class="size-[18px]" />
            {t(lang, 'inquiryAbout')}
          </a>
          <a href={tel} class="btn btn-ghost btn-lg">
            <Icon name="phone" class="size-[18px]" />
            <span class="tnum">{c.salesPhone}</span>
          </a>
          <a href={wa} target="_blank" rel="noopener nofollow" class="btn btn-ghost btn-lg">
            <Icon name="whatsapp" class="size-[18px]" />
            WhatsApp
          </a>
        </div>

        <p class="mt-5 text-[12.5px] leading-relaxed text-ink-400">
          {isEn
            ? 'Price on request — volume pricing available. Lead time confirmed when you order.'
            : '价格面议，支持批量阶梯价；下单时确认货期。'}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ================= 产品特性 ================= -->
<section class="section-tight bg-white">
  <div class="shell">
    <span class="eyebrow">{isEn ? 'Product features' : '产品特性'}</span>
    <h2 class="mt-3 text-[24px] font-semibold text-ink-900 md:text-[30px]">
      {isEn ? 'What goes into this filter' : '这只滤芯的用料与工艺'}
    </h2>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        productFeatures.map((f, i) => (
          <div class="card p-6" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <span class="font-mono text-[11px] tracking-[0.2em] text-brand-500">{f.no}</span>
            <h3 class="mt-3 text-[16px] font-semibold text-ink-900">{f.title[lang]}</h3>
            <p class="mt-2.5 text-[13px] leading-relaxed text-ink-500">{f.desc[lang]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ================= 适用领域 ================= -->
{
  relatedApps.length > 0 && (
    <section class="section-tight bg-ink-50">
      <div class="shell">
        <span class="eyebrow">{isEn ? 'Applications' : '适用领域'}</span>
        <h2 class="mt-3 text-[24px] font-semibold text-ink-900 md:text-[30px]">
          {isEn ? 'Machines and industries this fits' : '适配的设备与行业'}
        </h2>

        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedApps.map((a) => (
            <a href={p(`/applications/${a.slug}/`)} class="card card-hover group flex items-center gap-3.5 p-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white text-ink-500 ring-1 ring-ink-100 transition group-hover:bg-brand-500 group-hover:text-white">
                <Icon name={a.icon} class="size-[18px]" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[14px] font-semibold text-ink-900 group-hover:text-brand-600">
                  {isEn ? a.nameEn : a.nameZh}
                </span>
                <span class="mt-0.5 block truncate text-[12px] text-ink-400">
                  {isEn ? a.shortEn : a.shortZh}
                </span>
              </span>
            </a>
          ))}
        </div>

        <p class="mt-6 rounded-2xl bg-white p-5 text-[13px] leading-relaxed text-ink-500 ring-1 ring-ink-100">
          {
            isEn
              ? 'Fitment varies by machine year and configuration. Send us your machine model or a photo of the old filter and we will confirm before you order.'
              : '具体适配随机型年份与配置有所不同。把设备机型或旧滤芯照片发给我们，下单前帮你确认，避免买错。'
          }
        </p>
      </div>
    </section>
  )
}

<!-- ================= 相关件号 ================= -->
{
  related.length > 0 && (
    <section class="section bg-white">
      <div class="shell">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <span class="eyebrow">{isEn ? 'Related' : '相关件号'}</span>
            <h2 class="mt-3 text-[24px] font-semibold text-ink-900 md:text-[30px]">
              {isEn ? `Other ${typeLabel} numbers` : `同类 ${typeLabel} 件号`}
            </h2>
          </div>
          {group && (
            <a href={p(`/products/${group.slug}/`)} class="btn btn-ghost btn-sm">
              <Icon name="grid" class="size-4" />
              {isEn ? 'View group' : '查看大类'}
            </a>
          )}
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r, i) => (
            <div data-reveal style={`--reveal-delay:${(i % 4) * 45}ms`}>
              <ProductCard {lang} product={r} compact />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- ================= 询价 ================= -->
<section class="section bg-ink-50" id="quote">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <span class="eyebrow">{isEn ? 'Enquire' : '询价'}</span>
      <h2 class="mt-3 text-[24px] font-semibold text-ink-900 md:text-[32px]">
        {isEn ? `Enquire about ${product.partNo}` : `询价 ${product.partNo}`}
      </h2>
      <p class="mt-4 text-[14.5px] leading-relaxed text-ink-500">
        {isEn
          ? 'Tell us the quantity and delivery deadline and we will come back with pricing, stock status and lead time within one business day.'
          : '告诉我们数量和交期要求，一个工作日内回复价格、库存状态与货期。'}
      </p>

      <FaqList items={quickFaqs} {lang} class="mt-8" />
    </div>

    <div class="lg:col-span-7">
      <InquiryForm {lang} presetPartNo={product.partNo} />
    </div>
  </div>
</section>

<script>
  /* 复制件号 */
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? ''
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')
      const original = label?.textContent ?? ''
      try {
        await navigator.clipboard.writeText(value)
        if (label) {
          label.textContent = document.documentElement.lang.startsWith('en') ? 'Copied' : '已复制'
          window.setTimeout(() => (label.textContent = original), 1600)
        }
      } catch {
        /* 剪贴板不可用时静默失败 */
      }
    })
  })
</script>
