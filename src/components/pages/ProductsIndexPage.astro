---
/**
 * ProductsIndexPage.astro — 产品中心总览
 */
import siteConfig from '../../../site.config.mjs'
import { t, localizePath } from '../../i18n/index.mjs'
import { groups, groupStats, productCount, typeCount, categoryCount } from '../../data/products.mjs'
import Icon from '../Icon.astro'
import SectionHeading from '../SectionHeading.astro'
import PageHero from '../PageHero.astro'
import InquiryForm from '../InquiryForm.astro'

interface Props {
  lang: 'zh' | 'en'
}
const { lang } = Astro.props
const isEn = lang === 'en'
const p = (path: string) => localizePath(path, lang)
const pr = siteConfig.principal

const crumbs = [
  { label: t(lang, 'home'), href: '/' },
  { label: t(lang, 'productsTitle') },
]
---

<!-- Hero -->
<PageHero
  {lang}
  eyebrow={isEn ? 'Product centre' : '产品中心'}
  title={isEn ? 'Every filter we supply, organised the way you buy' : '按你的采购习惯，重新整理过的滤芯目录'}
  desc={isEn
    ? `Authorized ${pr.nameEn} products, grouped into ${groups.length} application families covering ${categoryCount} categories — each part number carries its real dimensions so you can match before you order.`
    : `富滤盛授权正品，按 ${groups.length} 个应用大类、${categoryCount} 个细分品类整理，每个件号都带真实规格尺寸，下单前就能核对。`}
  crumbs={crumbs}
  stats={[
    { value: productCount, label: isEn ? 'Part numbers' : '已收录件号' },
    { value: categoryCount, label: isEn ? 'Categories' : '细分品类' },
    { value: typeCount, label: isEn ? 'Product types' : '产品类型' },
  ]}
  statCols={3}
/>

<!-- 大类列表 -->
<section class="section bg-white">
  <div class="shell">
    <SectionHeading
      eyebrow={isEn ? 'Groups' : '产品大类'}
      title={isEn ? 'Browse by application family' : '按应用大类浏览'}
      desc={isEn
        ? 'Each group carries its own category breakdown, summary table and selection notes.'
        : '每个大类都有独立的品类拆分、件号汇总表与选型说明。'}
    />

    <div class="mt-12 space-y-4">
      {
        groups.map((g, i) => {
          const stat = groupStats[g.slug]
          return (
            <a
              href={p(`/products/${g.slug}/`)}
              class="card card-hover group grid gap-6 overflow-hidden p-0 md:grid-cols-[280px_1fr] lg:grid-cols-[340px_1fr]"
              data-reveal
              style={`--reveal-delay:${i * 40}ms`}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-ink-50 md:aspect-auto md:h-full md:min-h-[200px]">
                <img
                  src={g.image}
                  alt={isEn ? g.nameEn : g.nameZh}
                  width="700"
                  height="440"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
                <span class="absolute left-4 top-4 rounded-md bg-white/85 px-2 py-1 font-mono text-[11px] tracking-widest text-ink-500 backdrop-blur-sm">
                  {g.no}
                </span>
              </div>

              <div class="flex flex-col p-5 md:py-6 md:pl-0 md:pr-7">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
                    <Icon name={g.icon} class="size-5" />
                  </span>
                  <h2 class="text-[19px] font-semibold text-ink-900 transition group-hover:text-brand-600 md:text-[22px]">
                    {isEn ? g.nameEn : g.nameZh}
                  </h2>
                  <span class="chip chip-brand tnum">
                    {stat?.count ?? 0} {t(lang, 'productsCount')}
                  </span>
                </div>

                <p class="mt-3 text-[14px] leading-relaxed text-ink-500">
                  {isEn ? g.descEn : g.descZh}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {
                    (stat?.types ?? []).slice(0, 8).map((tp) => (
                      <span class="chip">{tp}</span>
                    ))
                  }
                  {(stat?.typeCount ?? 0) > 8 && (
                    <span class="chip chip-brand">+{(stat?.typeCount ?? 0) - 8}</span>
                  )}
                </div>

                <span class="mt-auto inline-flex items-center gap-2 pt-5 text-[13.5px] font-semibold text-brand-600">
                  {isEn ? 'View group' : '查看该大类'}
                  <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          )
        })
      }
    </div>
  </div>
</section>

<!-- 询价 -->
<section class="section bg-ink-50">
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <span class="eyebrow">{isEn ? 'Cannot find it?' : '没找到？'}</span>
      <h2 class="mt-3 text-[26px] font-semibold leading-tight text-ink-900 md:text-[34px]" data-reveal>
        {isEn ? 'Our catalogue is not the whole factory range' : '我们收录的只是常用部分'}
      </h2>
      <p class="mt-4 text-[14.5px] leading-relaxed text-ink-500" data-reveal>
        {
          isEn
            ? `The factory produces over ${pr.facts.skuCount.toLocaleString()} part numbers. If yours is not listed, send it over — we will check with the factory and come back with the correct number and lead time.`
            : `厂家在产件号超过 ${pr.facts.skuCount.toLocaleString()} 个。如果目录里没有你要的，把件号发给我们，我们向厂家核实后回复正确的件号与货期。`
        }
      </p>
    </div>
    <div class="lg:col-span-7">
      <InquiryForm {lang} />
    </div>
  </div>
</section>
