<section class="relative overflow-hidden border-t border-ink-100 bg-white py-20 md:py-24">
  <div
    class="pointer-events-none absolute right-1/4 top-1/2 size-[600px] -translate-y-1/2 rounded-full opacity-[0.12] blur-[110px]"
    style="background: radial-gradient(closest-side, #2F6BFF, transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <span class="eyebrow">{tx(lang, 'Get a quote', '获取报价')}</span>
      <h2 class="mt-3 text-[28px] font-semibold leading-tight text-ink-900 md:text-[38px]" data-reveal>
        {tx(lang, 'Send the part number — we handle the rest', '把件号发过来，剩下的交给我们')}
      </h2>
      <p class="mt-5 text-[15px] leading-[1.85] text-ink-500" data-reveal>
        {tx(lang, 'Quotation and lead time within one business day. Bulk orders, custom builds and export enquiries are all welcome.', '一个工作日内回复报价与货期。批量采购、非标定制、出口订单同样欢迎。')}
      </p>

      <ul class="mt-9 space-y-3" data-reveal>
        {
          [
            { icon: 'phone', label: tx(lang, 'Sales hotline', '销售热线'), value: c.salesPhone, href: tel },
            ...(c.landline
              ? [{ icon: 'headset', label: tx(lang, 'Landline', '座机'), value: c.landline, href: `tel:${c.landline.replace(/[^\d+]/g, '')}` }]
              : []),
            { icon: 'wechat', label: tx(lang, 'WeChat', '微信'), value: c.wechatId, href: null },
            { icon: 'whatsapp', label: 'WhatsApp', value: c.whatsappDisplay, href: wa },
            { icon: 'mail', label: tx(lang, 'Email', '邮箱'), value: c.email, href: `mailto:${c.email}` },
          ].map((row) => (
            <li class="flex items-center gap-4 rounded-2xl bg-white p-4 shadow-soft ring-1 ring-ink-100">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name={row.icon} class="size-[18px]" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11.5px] text-ink-400">{row.label}</span>
                {row.href ? (
                  <a
                    href={row.href}
                    target={row.href.startsWith('http') ? '_blank' : undefined}
                    rel={row.href.startsWith('http') ? 'noopener nofollow' : undefined}
                    class="tnum block truncate text-[14.5px] font-medium text-ink-900 transition hover:text-brand-600"
                  >
                    {row.value}
                  </a>
                ) : (
                  <span class="tnum block truncate text-[14.5px] font-medium text-ink-900">{row.value}</span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-7" data-reveal="right">
      <InquiryForm {lang} />
    </div>
  </div>
</section>
